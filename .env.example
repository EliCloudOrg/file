# EliCloud 文件服务 —— 环境变量示例
#
# 本地开发：复制成 .env.local（不要提交），docker compose up -d 即可。
# 生产部署：这些值放服务器 /srv/file/app.env（600，deploy:deploy），
#          由 deploy/deploy.sh 读出后写进 docker 可见项目目录的 .env。
#          ⚠️ 绝不要提交到 Git、不要写进镜像层、不要打印到日志。

# ---- SSO 接入（必须与 SSO 的 PUBLIC_BASE_URL 逐字一致）----
SSO_ISSUER=https://146.56.237.33/auth
SSO_JWKS_URL=https://146.56.237.33/auth/.well-known/jwks.json
JWT_AUDIENCE=elicloud-services
# 令牌必须含这些 scope；配成空串 = 关闭对应校验（只允许本地调试）
REQUIRED_READ_SCOPE=files:read
REQUIRED_WRITE_SCOPE=files:write

# ---- 元数据存储（只放 SQLite，不放文件内容）----
DATABASE_URL=sqlite:////data/file.db

# ---- 内容存储 ----
# local：本地磁盘（测试/本地开发）；cos：腾讯云 COS（生产，必须填齐凭据）
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/data/blobs
TEMP_ROOT=/data/tmp

# ---- COS（STORAGE_BACKEND=cos 时必填；缺了即启动失败）----
# 私有桶：elicoudcos-1465229333（ap-nanjing，150 GiB）
# ⚠️ 不要用 elicoud-cos-1465229333（/elicos 那个桶匿名可列举，只能放公开内容）
COS_REGION=ap-nanjing
COS_BUCKET=elicoudcos-1465229333
COS_SECRET_ID=
COS_SECRET_KEY=
# 对象 key 前缀：与同桶里的其它业务隔离，CAM 策略也按它收敛
COS_KEY_PREFIX=elicloud-file
# 留空 = cos.<region>.myqcloud.com（同地域走内网，内网流量免费）
COS_ENDPOINT=
COS_SCHEME=https
COS_TIMEOUT_SECONDS=10
COS_MAX_RETRIES=3

# ---- 下载链路 ----
# proxy：一律流式代理；presign：默认 302 到预签名 URL；
# both：默认代理，带 ?direct=1 时 302。local 后端会自动回落代理。
DOWNLOAD_MODE=proxy
PRESIGN_EXPIRES_SECONDS=300

# ---- 业务限制 ----
MAX_FILE_BYTES=26214400
DEFAULT_TTL_SECONDS=604800
MAX_TTL_SECONDS=2592000
DEFAULT_VISIBILITY=private
MAX_GRANTS_PER_FILE=100

# 每用户配额
QUOTA_MAX_FILES=200
QUOTA_MAX_BYTES=1073741824

# 服务总容量（默认 90 GiB：150 GiB 桶留余量，并考虑 2027-08-11 后容量包降档）
MAX_TOTAL_BYTES=96636764160
STORAGE_WARN_PERCENT=80
# 容量包到期日（用于启动/stats 提醒；留空 = 不提醒）
CAPACITY_EXPIRES_AT=2027-08-11

# 本地暂存盘余量门槛
MIN_FREE_BYTES=536870912

# 写操作限流（按 sub + IP）
UPLOAD_ATTEMPTS_PER_WINDOW=30
UPLOAD_WINDOW_SECONDS=600

# 清理器
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=60
CLEANUP_BATCH_SIZE=200
TOMBSTONE_RETENTION_DAYS=30
TEMP_FILE_MAX_AGE_SECONDS=3600

# ---- 通用 ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
